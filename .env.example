MONGODB_URI=mongodb://127.0.0.1:27017/foodie_express
# Generate: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata

# Gemini (get a NEW key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Razorpay (ADMIN / platform account; Route must be enabled for restaurant payouts)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Business rules
PLATFORM_COMMISSION_PCT=15
TAX_PCT=5
DELIVERY_BASE_FEE=25
DELIVERY_PER_KM=8
MAX_DELIVERY_KM=15
RIDER_SHARE_PCT=80

# Seed (npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisNow!123
SEED_DEMO=true
